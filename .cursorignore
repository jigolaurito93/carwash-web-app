# =============================================================================
# Cursor context exclusions
# Keep build artifacts, dependencies, caches, secrets, and large binaries
# out of the AI context window. Source code stays indexed.
# =============================================================================

# ----- Dependencies -----
node_modules/
.pnp
.pnp.*
.yarn/
.pnpm-store/
.pnpm/

# ----- Next.js / production builds -----
.next/
out/
build/
dist/
.turbo/
.vercel/

# ----- Caches, coverage, TypeScript incremental -----
**/.cache/
**/coverage/
*.tsbuildinfo
next-env.d.ts

# ----- Lockfiles (large generated graphs; package.json is enough) -----
pnpm-lock.yaml
package-lock.json
yarn.lock

# ----- Env and secrets -----
.env
.env.*
!.env.example
*.pem
*.key

# ----- Logs and debug -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# ----- Source maps -----
*.map

# ----- Supabase CLI local cache -----
supabase/.temp/
supabase/.branches/

# ----- Large / binary media -----
# Photos, raster logos, video, audio, fonts
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.avif
*.bmp
*.tiff
*.ico
*.mp4
*.mov
*.webm
*.avi
*.mp3
*.wav
*.ogg
*.woff
*.woff2
*.ttf
*.otf
*.eot

# Image dumps under public (keep small SVGs indexed)
public/images/
public/**/*.jpg
public/**/*.jpeg
public/**/*.png
public/**/*.webp
public/**/*.gif

# ----- OS / editor junk -----
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo

# ----- Git internals -----
.git/
