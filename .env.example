# Copy to .env.local and fill in values from each provider dashboard.
# Never commit real secrets. Names only in this file.

# Supabase → Project Settings → API
# Project URL
NEXT_PUBLIC_SUPABASE_URL=
# anon / public key (browser-safe; Row Level Security still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud → APIs & Services → Credentials
# Maps JavaScript API key (public contact-page map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend → API Keys
# Server-only. Sends the public contact form.
RESEND_API_KEY=

# Inbox that receives contact-form messages (server-only)
OWNER_EMAIL=

# Supabase → Project Settings → API → service_role
# Server-only. Used for admin invites and onboarding metadata.
# Never expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=
